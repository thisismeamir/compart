---
// src/components/blocks/Marginalia.astro
interface Props { n?: number | string }
const { n } = Astro.props;
---
<aside
  class="my-6 border-l border-rule pl-4 font-display text-small text-muted
         lg:col-start-2 lg:row-span-1 lg:my-0 lg:self-start lg:border-l-0 lg:pl-0"
>
  {n && <span class="mr-1 font-code text-accent">{n}</span>}
  <slot />
</aside>
