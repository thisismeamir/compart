---
interface Props {
  n: number | string;
  title: string;
  meta?: string;
}

const { n, title, meta } = Astro.props;
const label = typeof n === 'number' ? String(n).padStart(2, '0') : n;
---
<li class="grid grid-cols-[3.5rem_1fr] gap-x-4 py-6 text-ink">
  <span class="font-code text-h4 font-normal leading-none text-accent">
    {label}
  </span>
  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <h4 class="font-display text-h4 font-light text-ink">{title}</h4>
      {meta && (
        <span class="font-code text-label uppercase text-muted">{meta}</span>
      )}
    </div>
    <div class="mt-3 font-text text-body text-ink">
      <slot />
    </div>
  </div>
</li>
