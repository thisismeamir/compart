---
export type NodeVariant = 'base' | 'muted' | 'accent';
export type EdgeStyle = 'solid' | 'dashed';

export interface GraphNode {
  id: string;
  col: number;
  row: number;
  colSpan?: number;
  rowSpan?: number;
  variant?: NodeVariant;
  kicker?: string;
  title: string;
  body?: string | string[];
  phase?: number;
  step?: number;
}

export interface GraphEdge {
  from: string;
  to: string;
  label?: string;
  phase?: number;
  step?: number;
  style?: EdgeStyle;
}

export interface GraphSpec {
  grid: { cols: number; rows: number };
  nodes: GraphNode[];
  edges: GraphEdge[];
}

interface Props {
  spec: GraphSpec;
  title?: string;
  interactive?: boolean;
  span?: 'main' | 'wide';
}

const {
  spec,
  title,
  interactive = true,
  span = 'wide',
} = Astro.props;

const spans = { main: '', wide: 'lg:col-span-full' } as const;

const maxStep = Math.max(
  0,
  ...spec.nodes.map((n) => n.step ?? 0),
  ...spec.edges.map((e) => e.step ?? 0),
);
const hasSteps = interactive && maxStep > 0;

const variantClasses: Record<NodeVariant, string> = {
  base:   'bg-paper border-ink text-ink',
  muted:  'bg-slate-20 border-slate-50 text-slate-100 on-dark:bg-slate-80 on-dark:border-slate-50 on-dark:text-slate-10',
  accent: 'bg-accent border-accent text-white',
};

const payload = JSON.stringify({ spec, maxStep, hasSteps });
---
<div
  class={`my-10 border border-rule bg-paper text-ink ${spans[span]}`}
  data-mindmap
  tabindex="0"
>
  {(title || hasSteps) && (
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-rule px-4 py-2.5">
      <span class="font-display text-label uppercase text-muted">
        {title ?? 'Concept Map'}
      </span>

      {hasSteps && (
        <div class="flex items-center gap-2 font-code text-label uppercase">
          <span data-mm-counter class="mr-1 text-muted">
            Step {maxStep} / {maxStep}
          </span>
          <button
            type="button"
            data-mm-prev
            class="cursor-pointer border border-rule px-2 py-1 text-ink transition hover:border-accent hover:text-accent disabled:opacity-40"
          >
            Prev
          </button>
          <button
            type="button"
            data-mm-next
            class="cursor-pointer border border-rule px-2 py-1 text-ink transition hover:border-accent hover:text-accent disabled:opacity-40"
          >
            Next
          </button>
          <button
            type="button"
            data-mm-all
            class="cursor-pointer border border-rule px-2 py-1 text-accent transition hover:bg-accent hover:text-white"
          >
            All
          </button>
        </div>
      )}
    </div>
  )}

  <div class="overflow-x-auto p-4">
    <div data-mm-stage class="relative min-w-[42rem] p-2">
      <div
        data-mm-grid
        class="relative z-10 grid gap-5"
        style={`grid-template-columns: repeat(${spec.grid.cols}, minmax(0, 1fr)); grid-template-rows: repeat(${spec.grid.rows}, auto);`}
      >
        {spec.nodes.map((node) => (
          <article
            data-mm-node={node.id}
            data-mm-step={node.step ?? 0}
            class={`flex flex-col justify-start gap-2 border-[1.5px] p-3.5 transition-[opacity,transform] duration-200 ${variantClasses[node.variant ?? 'base']}`}
            style={`grid-column: ${node.col + 1} / span ${node.colSpan ?? 1}; grid-row: ${node.row + 1} / span ${node.rowSpan ?? 1};`}
          >
            {node.kicker && (
              <p class="m-0 font-display text-label uppercase opacity-75">
                {node.kicker}
              </p>
            )}
            <h4 class="m-0 font-display text-h4 font-light leading-snug" data-mm-rich={node.title}>
              {node.title}
            </h4>
            {typeof node.body === 'string' && node.body && (
              <p class="m-0 font-text text-small leading-relaxed" data-mm-rich={node.body}>
                {node.body}
              </p>
            )}
            {Array.isArray(node.body) && node.body.length > 0 && (
              <ul class="m-0 flex list-[square] flex-col gap-1 pl-4 font-text text-small">
                {node.body.map((item) => (
                  <li data-mm-rich={item}>{item}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </div>

      <div
        data-mm-edges
        class="pointer-events-none absolute inset-0 z-20 text-ink"
        role="presentation"
      />
    </div>
  </div>

  <script type="application/json" data-mm-spec set:html={payload} />
</div>
