---
export type IconName =
  | 'text'
  | 'sigma'
  | 'steps'
  | 'spark'
  | 'code'
  | 'check'
  | 'image'
  | 'graph'
  | 'plot'
  | 'copy';

interface Props {
  name: IconName | string;
  class?: string;
}

const { name, class: className = 'size-4' } = Astro.props;

const paths: Record<string, string> = {
  text:  'M4 6h16M4 12h12M4 18h16',
  sigma: 'M18 5H7l6 7-6 7h11',
  steps: 'M5 6h4v4h4v4h6M5 18h14',
  spark: 'M12 3l2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z',
  code:  'M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16',
  check: 'M5 13l4 4L19 7',
  image: 'M4 5h16v14H4zM4 15l4-4 3 3 5-5 4 4',
  graph: 'M4 6h5v4H4zM15 4h5v4h-5zM15 14h5v4h-5zM9 8h3v-2h3M12 8v8h3',
  plot:  'M4 19V5M4 19h16M7 15l4-5 3 2 5-6',
  copy:  'M9 9h10v11H9zM5 15H4V4h11v1',
};
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  class={className}
>
  <path d={paths[name] ?? paths.text} />
</svg>
