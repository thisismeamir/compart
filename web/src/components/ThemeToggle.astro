---
// src/components/ThemeToggle.astro
---
<button
  type="button"
  data-theme-toggle
  aria-label="Toggle color theme"
  class="cursor-pointer border border-rule bg-paper px-2.5 py-1 font-code text-label uppercase text-ink transition hover:border-accent hover:text-accent"
>
  <span data-theme-label>Dark</span>
</button>

<script is:inline>
  (() => {
    const btn = document.querySelector('[data-theme-toggle]');
    const label = btn?.querySelector('[data-theme-label]');
    if (!btn || !label) return;

    const sync = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      label.textContent = isDark ? 'Light' : 'Dark';
      btn.setAttribute('aria-pressed', String(isDark));
    };

    sync();

    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('compart-theme', next);
      sync();
      window.dispatchEvent(new CustomEvent('compart:theme-change', { detail: { theme: next } }));
    });
  })();
</script>
