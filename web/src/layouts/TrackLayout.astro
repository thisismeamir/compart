---
import Base from './Base.astro';
import type { TrackId } from '../data/curriculum';

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  trackId: TrackId;
  name: string;
  focus: string;
  pathSummary: string;
  partCount: number;
  lectureCount: number;
  targetedCount: number;
  prevTrack?: NavLink;
  nextTrack?: NavLink;
}

const {
  trackId,
  name,
  focus,
  pathSummary,
  partCount,
  lectureCount,
  targetedCount,
  prevTrack,
  nextTrack,
} = Astro.props;

const allTracks: { id: TrackId; label: string; href: string }[] = [
  { id: 'analyst', label: 'Analyst', href: '/tracks/analyst' },
  { id: 'detector', label: 'Detector', href: '/tracks/detector' },
  { id: 'simulation', label: 'Simulation', href: '/tracks/simulation' },
  { id: 'software', label: 'Software', href: '/tracks/software' },
];
---

<Base title={`${name} — ComPart`} description={focus} showNav={true}>
  <section class="border-b border-rule bg-paper py-16 text-ink">
    <div class="mx-auto max-w-6xl px-6">
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 font-code text-label uppercase text-muted">
        <a href="/" class="transition hover:text-ink">ComPart</a>
        <span>/</span>
        <a href="/#tracks" class="transition hover:text-ink">Tracks</a>
        <span>/</span>
        <span class="text-ink">{name}</span>
      </nav>

      <div class="mb-8 flex flex-wrap gap-2 font-code text-label uppercase">
        {allTracks.map((t) => (
          <a
            href={t.href}
            aria-current={t.id === trackId ? 'page' : undefined}
            class={`border px-3 py-1.5 transition ${
              t.id === trackId
                ? 'border-accent bg-accent text-white'
                : 'border-rule bg-paper text-ink hover:border-accent hover:text-accent'
            }`}
          >
            {t.label} Track
          </a>
        ))}
      </div>

      <p class="font-display text-label uppercase text-accent">Specialization Track</p>
      <h1 class="mt-3 font-display text-h1 font-light text-ink">{name}</h1>
      <p class="mt-5 max-w-3xl font-text text-body text-muted">{focus}</p>

      <div class="mt-8 border-l-2 border-accent pl-5">
        <p class="font-code text-label uppercase text-muted">Canonical Sequence</p>
        <p class="mt-1 font-code text-small text-ink">{pathSummary}</p>
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-6 border-t border-rule pt-8 sm:grid-cols-3">
        <div>
          <dd class="font-display text-h2 font-light text-ink">{partCount}</dd>
          <dt class="mt-1 font-display text-small text-ink">Parts Covered</dt>
          <p class="mt-1 font-code text-label uppercase text-muted">Full & Targeted</p>
        </div>
        <div>
          <dd class="font-display text-h2 font-light text-ink">{lectureCount}</dd>
          <dt class="mt-1 font-display text-small text-ink">Lectures on Track</dt>
          <p class="mt-1 font-code text-label uppercase text-muted">Ordered Sequence</p>
        </div>
        <div>
          <dd class="font-display text-h2 font-light text-ink">{targetedCount}</dd>
          <dt class="mt-1 font-display text-small text-ink">Targeted Subsets</dt>
          <p class="mt-1 font-code text-label uppercase text-muted">Selected Lectures</p>
        </div>
      </dl>
    </div>
  </section>

  <div class="bg-paper text-ink">
    <slot />
  </div>

  {(prevTrack || nextTrack) && (
    <nav aria-label="Adjacent tracks" class="border-t border-rule bg-paper font-display text-ink">
      <div class="mx-auto grid max-w-6xl grid-cols-2 divide-x divide-rule">
        <div class="p-6">
          {prevTrack && (
            <a href={prevTrack.href} class="group block">
              <span class="block font-code text-label uppercase text-muted">← Previous Track</span>
              <span class="mt-1 block text-small text-ink group-hover:text-accent">{prevTrack.label}</span>
            </a>
          )}
        </div>
        <div class="p-6 text-right">
          {nextTrack && (
            <a href={nextTrack.href} class="group block">
              <span class="block font-code text-label uppercase text-muted">Next Track →</span>
              <span class="mt-1 block text-small text-ink group-hover:text-accent">{nextTrack.label}</span>
            </a>
          )}
        </div>
      </div>
    </nav>
  )}

  <script>
    import '../scripts/mindmap';
  </script>
</Base>
