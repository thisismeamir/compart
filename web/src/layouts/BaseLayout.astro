---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ComPart — From First Principles to FCC",
  description = "A unified graduate-level high-energy physics curriculum spanning 15 Parts and 123 Lectures from mathematical foundations to FCC.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      const stored = localStorage.getItem("compart-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-slate-50/85 backdrop-blur-md dark:border-slate-800/80 dark:bg-slate-950/85">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight text-slate-900 dark:text-white">
          <span class="inline-flex h-7 w-7 items-center justify-center rounded-md bg-blue-700 font-mono text-xs font-bold text-white dark:bg-sky-500 dark:text-slate-950">
            CP
          </span>
          <span>ComPart</span>
        </a>

        <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300 sm:flex">
          <a href="#overview" class="transition hover:text-blue-700 dark:hover:text-sky-400">Overview</a>
          <a href="#tracks" class="transition hover:text-blue-700 dark:hover:text-sky-400">Tracks</a>
          <a href="#spine" class="transition hover:text-blue-700 dark:hover:text-sky-400">Curriculum Spine</a>
        </nav>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle dark mode"
          class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:bg-slate-100 dark:border-slate-800 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          <span class="dark:hidden">Dark</span>
          <span class="hidden dark:inline">Light</span>
        </button>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-12 sm:px-6 sm:py-16">
      <slot />
    </main>

    <footer class="border-t border-slate-200/80 py-8 text-xs text-slate-500 dark:border-slate-800/80 dark:text-slate-400">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-4 sm:flex-row sm:px-6">
        <p>ComPart 2026 · MIT License</p>
        <a href="https://github.com/thisismeamir/compart" class="font-mono">Check on GitHub</a>
      </div>
    </footer>

    <script is:inline>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("compart-theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>
